{
  "name": "dialog-rsn-1-voice-widget",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A drop-in browser voice assistant on Dialog-RSN-1: a React widget packaged as a custom element, a Node relay that holds the key, and a test website",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build",
    "prestart": "vite build",
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "vite build --watch --mode development & node --env-file-if-exists=.env --watch server.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5"
  }
}
